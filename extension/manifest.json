{
    "manifest_version": 3,
    "name": "AniPresence",
    "version": "1.4.2",
    "description": "Show your anime & manga on Discord, with your MyAnimeList right at your fingertips. Update episodes, scores and status on the spot.",

    "icons": {
        "128": "icon.png"
    },

    "permissions": [
        "tabs",
        "storage"
    ],

    "host_permissions": [
        "https://www.miruro.tv/*",
        "https://www.miruro.bz/*",
        "https://www.miruro.to/*",
        "https://www.miruro.ru/*",
        "https://animetsu.net/*",
        "https://animetsu.cc/*",
        "https://animetsu.live/*",
        "https://animetsu.bz/*",
        "https://www.crunchyroll.com/*",
        "https://crunchyroll.com/*",
        "https://animepahe.pw/*",
        "https://kwik.cx/*",
        "http://127.0.0.1:5001/*"
    ],

    "background": {
        "service_worker": "background.js"
    },

    "action": {
        "default_icon": "icon.png",
        "default_popup": "dashboard.html"
    },

    "content_scripts": [
        {
            "matches": ["https://www.miruro.tv/*", "https://www.miruro.bz/*", "https://www.miruro.to/*", "https://www.miruro.ru/*", "https://animetsu.net/*", "https://animetsu.live/*", "https://animetsu.cc/*", "https://animetsu.bz/*", "https://www.crunchyroll.com/*", "https://crunchyroll.com/*", "https://animepahe.pw/*"],
            "js": ["helpers.js", "config.js", "content.js"]
        },
        {
            "matches": ["https://kwik.cx/*"],
            "js": ["helpers.js", "kwik.js"],
            "all_frames": true
        }
    ]
}