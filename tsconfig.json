{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "strict": false,
    "rootDir": "extension",
    "outDir": "extension",
    "types": ["chrome"],
    "skipLibCheck": true
  },
  "include": ["extension/**/*.ts"],
  "exclude": ["node_modules"]
}
